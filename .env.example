# --- Supabase ----------------------------------------------------------------
VITE_SUPABASE_URL=https://<your-project>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<your-supabase-publishable-key>
VITE_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# --- Groq --------------------------------------------------------------------
VITE_GROQ_API_KEY=<your-groq-api-key>
GROQ_API_KEY=<your-groq-api-key>

# --- Posture-correction backend (FastAPI / WebSocket) ------------------------
# Production: point to the Render-deployed FastAPI backend
# VITE_POSTURE_WS_URL=wss://fitzer-sih.onrender.com/ws/pose
#
# Local dev: leave this variable unset (or commented out) to fall back to:
#   ws://localhost:8000/ws/pose
VITE_POSTURE_WS_URL=wss://fitzer-sih.onrender.com/ws/pose
